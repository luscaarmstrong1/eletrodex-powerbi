table AuxEquipamentoA
	lineageTag: aux-eqa-001

	column EquipamentoID_A
		dataType: int64
		formatString: 0
		lineageTag: aux-eqa-col-id
		summarizeBy: none
		sourceColumn: EquipamentoID

	column NomeDisplay_A
		dataType: string
		lineageTag: aux-eqa-col-nom
		summarizeBy: none
		sourceColumn: NomeDisplay_A

	column Categoria_A
		dataType: string
		lineageTag: aux-eqa-col-cat
		summarizeBy: none
		sourceColumn: Categoria_A

	partition AuxEquipamentoA = calculated
		mode: import
		source =
			SELECTCOLUMNS(
				DimEquipamentos,
				"EquipamentoID", DimEquipamentos[EquipamentoID],
				"NomeDisplay_A", RELATED(DimFabricantes[Nome]) & " " & DimEquipamentos[Modelo] & " (" & DimEquipamentos[CodigoEletrodex] & ")",
				"Categoria_A", RELATED(DimCategorias[Nome])
			)
