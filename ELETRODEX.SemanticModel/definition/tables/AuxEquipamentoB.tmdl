table AuxEquipamentoB
	lineageTag: aux-eqb-001

	column EquipamentoID_B
		dataType: int64
		formatString: 0
		lineageTag: aux-eqb-col-id
		summarizeBy: none
		sourceColumn: EquipamentoID

	column NomeDisplay_B
		dataType: string
		lineageTag: aux-eqb-col-nom
		summarizeBy: none
		sourceColumn: NomeDisplay_B

	column Categoria_B
		dataType: string
		lineageTag: aux-eqb-col-cat
		summarizeBy: none
		sourceColumn: Categoria_B

	partition AuxEquipamentoB = calculated
		mode: import
		source =
			SELECTCOLUMNS(
				DimEquipamentos,
				"EquipamentoID", DimEquipamentos[EquipamentoID],
				"NomeDisplay_B", RELATED(DimFabricantes[Nome]) & " " & DimEquipamentos[Modelo] & " (" & DimEquipamentos[CodigoEletrodex] & ")",
				"Categoria_B", RELATED(DimCategorias[Nome])
			)
