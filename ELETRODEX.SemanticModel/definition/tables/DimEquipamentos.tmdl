table DimEquipamentos
	lineageTag: eq-001

	column EquipamentoID
		dataType: int64
		isKey
		formatString: 0
		lineageTag: eq-col-id
		summarizeBy: none
		sourceColumn: EquipamentoID

	column CodigoEletrodex
		dataType: string
		lineageTag: eq-col-cod
		summarizeBy: none
		sourceColumn: CodigoEletrodex

	column FabricanteID
		dataType: int64
		formatString: 0
		lineageTag: eq-col-fabid
		summarizeBy: none
		sourceColumn: FabricanteID

	column CategoriaID
		dataType: int64
		formatString: 0
		lineageTag: eq-col-catid
		summarizeBy: none
		sourceColumn: CategoriaID

	column Modelo
		dataType: string
		lineageTag: eq-col-mod
		summarizeBy: none
		sourceColumn: Modelo

	column Variante
		dataType: string
		lineageTag: eq-col-var
		summarizeBy: none
		sourceColumn: Variante

	column Descricao
		dataType: string
		lineageTag: eq-col-desc
		summarizeBy: none
		sourceColumn: Descricao

	column AplicacaoPrincipal
		dataType: string
		lineageTag: eq-col-apl
		summarizeBy: none
		sourceColumn: AplicacaoPrincipal

	column ClasseEditorial
		dataType: string
		lineageTag: eq-col-cla
		summarizeBy: none
		sourceColumn: ClasseEditorial

	column ImagemURL
		dataType: string
		dataCategory: ImageURL
		lineageTag: eq-col-img
		summarizeBy: none
		sourceColumn: ImagemURL

	column DataInclusao
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: eq-col-dt
		summarizeBy: none
		sourceColumn: DataInclusao

	column StatusValidacao
		dataType: string
		lineageTag: eq-col-st
		summarizeBy: none
		sourceColumn: StatusValidacao

	partition DimEquipamentos = m
		mode: import
		source =
			let
				Fonte = Csv.Document(File.Contents(CaminhoDados & "equipamentos.csv"),[Delimiter=";", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				Tipos = Table.TransformColumnTypes(Cabecalhos,{{"EquipamentoID", Int64.Type}, {"CodigoEletrodex", type text}, {"FabricanteID", Int64.Type}, {"CategoriaID", Int64.Type}, {"Modelo", type text}, {"Variante", type text}, {"Descricao", type text}, {"AplicacaoPrincipal", type text}, {"ClasseEditorial", type text}, {"ImagemURL", type text}, {"DataInclusao", type date}, {"StatusValidacao", type text}})
			in
				Tipos
